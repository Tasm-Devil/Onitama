# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Homepage URL: https://onitama.deneaux.de
# Authorization callback URL: https://onitama.deneaux.de/oauth2/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Cookie encryption secret (32+ bytes, base64-encoded)
# Generate with: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
COOKIE_SECRET=your_cookie_secret_here
